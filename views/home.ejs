<% layout("/layouts/boilerplate") %>


    
    <div class="card text-bg-dark hero">
        <img src="/photos/hero.jpg" class="card-img" alt="heroImage">

      </div>

      
    <div class="video">
        <p id="head1"> For the ones who want to remember how it felt..</p>
        <video class="protfolio video1" autoplay muted loop playsinline>
            <source src="/videos/main1.mp4" type="video/mp4">
          </video>
          <video  class="protfolio video2"autoplay muted loop playsinline>
            <source src="/videos/main2.mp4" type="video/mp4">
          </video>
          <video class="protfolio video3"autoplay muted loop playsinline>
            <source src="/videos/main3.mp4" type="video/mp4">
          </video>
          <video class="protfolio video4" autoplay muted loop playsinline>
            <source src="/videos/main4.mp4" type="video/mp4">
          </video>
          <video class="protfolio video5" autoplay muted loop playsinline>
            <source src="/videos/main5.mp4" type="video/mp4">
          </video>

    </div>
    
    <div class="reviews-section">
      <h2 class="rv-heading">Love Letters</h2>
      <!-- Reviews Section -->
      <section class="rv" aria-label="Customer reviews">
        <!-- Left Arrow -->
        <button class="rv-nav rv-prev" aria-label="Previous review" type="button">&#10094;</button>
      
        <!-- Left: Video -->
        <div id="rv-video-panel" class="rv-video-panel">
          <video id="rv-video"
                 class="rv-video"
                 preload="metadata"
                 autoplay
                 muted
                 loop
                 playsinline
                 poster="">
            <source id="rv-video-src" src="" type="video/mp4">
          </video>
        </div>
      
        <!-- Right: Review content -->
        <div class="rv-content">
          <div class="rv-inner">
            <div class="rv-title">
              <h3 id="rv-name" class="rv-name"></h3>
              <p id="rv-role" class="rv-role"></p>
            </div>
            <blockquote id="rv-quote" class="rv-quote"></blockquote>
            <div class="rv-dots" role="tablist" aria-label="Review navigation"></div>
          </div>
        </div>
      
        
        <button class="rv-nav rv-next" aria-label="Next review" type="button">&#10095;</button>
      
  
  <script id="reviews-data" type="application/json">
    <%- JSON.stringify(reviews || []) %>
  </script>
  <script src="/js/reviews-rotator.js" defer></script>
  
</section>
</div>

<div class="card text-bg-dark sage-date ">
  <img src="/photos/SageTheDate.jpg" class="card-img" alt="...">
  <div class="card-img-overlay sage-content">
    <p class="sage">Sage the Date</p>
    <a href="/inquire" class="btn btn-light">Inquire</a>
  </div>
</div>
    